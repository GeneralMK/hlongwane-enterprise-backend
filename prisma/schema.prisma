generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  PAYFAST
  OZOW
  PEACH_PAYMENTS
  PAYFLEX
  MOBICRED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum StockMovementType {
  STOCK_RECEIVED
  RESERVED
  RESERVATION_RELEASED
  SOLD
  RETURNED
  DAMAGED
  MANUAL_ADJUSTMENT
}

enum SerializedDeviceStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  REPAIR
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTING
  COMPLETED
  CANCELLED
}

enum ReturnItemCondition {
  UNOPENED
  OPENED
  USED
  DAMAGED
  FAULTY
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
  DELETED
}

enum FilePurpose {
  PRODUCT_IMAGE
  BRAND_LOGO
  CATEGORY_IMAGE
  USER_AVATAR
  RETURN_EVIDENCE
  WARRANTY_DOCUMENT
  INVOICE
  OTHER
}

enum StorageProvider {
  SUPABASE
}

enum ShipmentStatus {
  PENDING
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_SENDER
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// ============================================================
// USERS / AUTHENTICATION / RBAC
// ============================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  authUserId      String    @unique @db.Uuid
  email           String    @unique
  firstName       String
  lastName        String
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  avatarFileId String?     @unique @db.Uuid
  avatarFile   FileUpload? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  // RBAC
  userRoles     UserRole[] @relation("UserRoles")
  rolesAssigned UserRole[] @relation("UserRoleAssignedBy")

  // Admin-specific information
  adminProfile AdminProfile?

  // Customer information
  addresses      Address[]
  carts          Cart[]
  orders         Order[]
  returnRequests ReturnRequest[]

  // Operations performed by this user/admin
  stockMovements     StockMovement[]      @relation("StockMovementActor")
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")

  // Files
  uploadedFiles FileUpload[] @relation("UploadedFiles")

  // Notifications
  notifications Notification[]

  // Audit
  auditLogs AuditLog[] @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  module      String?
  isActive    Boolean @default(true)

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([isActive])
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  assignedByUserId String? @db.Uuid

  isActive   Boolean   @default(true)
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([isActive])
  @@index([assignedByUserId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ============================================================
// ADMIN
// ============================================================

model AdminProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  employeeCode String? @unique
  jobTitle     String?
  department   String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([department])
}

// ============================================================
// FILE STORAGE / UPLOADS
// ============================================================

model FileUpload {
  id String @id @default(uuid()) @db.Uuid

  uploadedByUserId String? @db.Uuid

  purpose FilePurpose

  status UploadStatus @default(PENDING)

  storageProvider StorageProvider @default(SUPABASE)

  bucket String
  path   String

  publicUrl String?

  originalName String
  mimeType     String
  extension    String?

  sizeBytes BigInt
  checksum  String?

  metadata Json?

  uploadedAt DateTime?
  deletedAt  DateTime?

  uploadedBy User? @relation("UploadedFiles", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  avatarFor User? @relation("UserAvatar")

  productImage ProductImage?

  brandLogo Brand? @relation("BrandLogoFile")

  categoryImage Category? @relation("CategoryImageFile")

  returnEvidence ReturnEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bucket, path])
  @@index([uploadedByUserId])
  @@index([purpose])
  @@index([status])
}

// ============================================================
// CUSTOMER ADDRESS
// ============================================================

model Address {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  label String?

  recipientName String
  phone         String

  line1 String
  line2 String?

  suburb String?
  city   String

  province   String
  postalCode String

  country String @default("ZA")

  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

// ============================================================
// PRODUCT CATALOGUE
// ============================================================

model Brand {
  id String @id @default(uuid()) @db.Uuid

  name String @unique
  slug String @unique

  description String?

  logoFileId String? @unique @db.Uuid

  logoFile FileUpload? @relation("BrandLogoFile", fields: [logoFileId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Category {
  id String @id @default(uuid()) @db.Uuid

  name String
  slug String @unique

  description String?

  imageFileId String? @unique @db.Uuid

  imageFile FileUpload? @relation("CategoryImageFile", fields: [imageFileId], references: [id], onDelete: SetNull)

  parentId String? @db.Uuid

  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)

  children Category[] @relation("CategoryTree")

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  name String
  slug String @unique

  shortDescription String?
  description      String?

  status ProductStatus @default(DRAFT)

  brandId    String @db.Uuid
  categoryId String @db.Uuid

  specifications Json?

  warrantyMonths Int?

  isFeatured Boolean @default(false)

  publishedAt DateTime?

  brand Brand @relation(fields: [brandId], references: [id])

  category Category @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([name])
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId    String @db.Uuid
  fileUploadId String @unique @db.Uuid

  altText String?

  position Int @default(0)

  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  fileUpload FileUpload @relation(fields: [fileUploadId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid

  sku String @unique

  barcode String? @unique

  price Decimal @db.Decimal(12, 2)

  salePrice Decimal? @db.Decimal(12, 2)

  costPrice Decimal? @db.Decimal(12, 2)

  attributes Json

  isActive Boolean @default(true)

  weightGrams Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventory Inventory?

  cartItems CartItem[]

  orderItems OrderItem[]

  reservations InventoryReservation[]

  stockMovements StockMovement[]

  serializedDevices SerializedDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  variantId String @unique @db.Uuid

  physicalQuantity Int @default(0)
  reservedQuantity Int @default(0)
  soldQuantity     Int @default(0)

  reorderLevel Int @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reorderLevel])
}

model InventoryReservation {
  id String @id @default(uuid()) @db.Uuid

  variantId String @db.Uuid

  cartId  String? @db.Uuid
  orderId String? @db.Uuid

  quantity Int

  status ReservationStatus @default(ACTIVE)

  expiresAt DateTime

  releasedAt DateTime?
  consumedAt DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  cart Cart? @relation(fields: [cartId], references: [id], onDelete: Cascade)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, status])
  @@index([cartId])
  @@index([orderId])
  @@index([expiresAt, status])
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  variantId String @db.Uuid

  type StockMovementType

  quantity Int

  previousPhysicalQuantity  Int
  resultingPhysicalQuantity Int

  previousReservedQuantity  Int
  resultingReservedQuantity Int

  referenceType String?
  referenceId   String?

  notes String?

  createdByUserId String? @db.Uuid

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdBy User? @relation("StockMovementActor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdByUserId])
}

model SerializedDevice {
  id String @id @default(uuid()) @db.Uuid

  variantId String @db.Uuid

  serialNumber String? @unique

  imei1 String? @unique
  imei2 String? @unique

  status SerializedDeviceStatus @default(AVAILABLE)

  orderItemId String? @db.Uuid

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, status])
  @@index([orderItemId])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  sessionKey String? @unique

  status CartStatus @default(ACTIVE)

  currency String @default("ZAR")

  expiresAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  reservations InventoryReservation[]

  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid

  cartId    String @db.Uuid
  variantId String @db.Uuid

  quantity Int

  unitPriceSnapshot Decimal @db.Decimal(12, 2)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id String @id @default(uuid()) @db.Uuid

  orderNumber String @unique

  userId String? @db.Uuid

  guestEmail String?

  cartId String? @unique @db.Uuid

  status OrderStatus @default(PENDING_PAYMENT)

  currency String @default("ZAR")

  subtotal Decimal @db.Decimal(12, 2)

  discountTotal Decimal @default(0) @db.Decimal(12, 2)

  deliveryFee Decimal @default(0) @db.Decimal(12, 2)

  taxTotal Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  // immutable checkout snapshots
  deliveryAddress Json
  billingAddress  Json?

  notes String?

  placedAt DateTime @default(now())

  paidAt DateTime?

  cancelledAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  cart Cart? @relation(fields: [cartId], references: [id], onDelete: SetNull)

  items OrderItem[]

  statusHistory OrderStatusHistory[]

  payments Payment[]

  reservations InventoryReservation[]

  refunds Refund[]

  returnRequests ReturnRequest[]

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([guestEmail])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  productId String? @db.Uuid
  variantId String? @db.Uuid

  // immutable product snapshots
  productNameSnapshot String
  skuSnapshot         String

  attributesSnapshot Json

  unitPrice Decimal @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  quantity Int

  lineTotal Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  serializedDevices SerializedDevice[]

  returnItems ReturnItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  status OrderStatus

  note String?

  changedByUserId String? @db.Uuid

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  changedBy User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([changedByUserId])
}

// ============================================================
// SHIPPING / DELIVERY
// ============================================================

model Shipment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  provider String

  serviceLevel String?

  trackingNumber String? @unique

  trackingUrl String?

  status ShipmentStatus @default(PENDING)

  shippedAt   DateTime?
  deliveredAt DateTime?

  metadata Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  events ShipmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model ShipmentEvent {
  id String @id @default(uuid()) @db.Uuid

  shipmentId String @db.Uuid

  status ShipmentStatus

  description String?

  location String?

  occurredAt DateTime

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shipmentId, occurredAt])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  provider PaymentProvider

  status PaymentStatus @default(INITIALIZED)

  reference String @unique

  providerReference String?

  amount Decimal @db.Decimal(12, 2)

  currency String @default("ZAR")

  checkoutUrl String?

  failureCode    String?
  failureMessage String?

  verifiedAt DateTime?

  paidAt DateTime?

  metadata Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  events PaymentEvent[]

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([provider, providerReference])
  @@index([status, createdAt])
}

model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid

  paymentId String @db.Uuid

  providerEventId String? @unique

  idempotencyKey String @unique

  eventType String

  signatureValid Boolean @default(false)

  payload Json

  processedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([eventType])
}

model Refund {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  paymentId String @db.Uuid

  status RefundStatus @default(REQUESTED)

  amount Decimal @db.Decimal(12, 2)

  reason String?

  providerReference String?

  processedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
}

// ============================================================
// RETURNS
// ============================================================

model ReturnRequest {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  requestedByUserId String? @db.Uuid

  status ReturnStatus @default(REQUESTED)

  reason String

  notes String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  requestedBy User? @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  items ReturnItem[]

  evidence ReturnEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([requestedByUserId])
  @@index([status])
}

model ReturnItem {
  id String @id @default(uuid()) @db.Uuid

  returnRequestId String @db.Uuid

  orderItemId String @db.Uuid

  quantity Int

  condition ReturnItemCondition?

  resolution String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnEvidence {
  id String @id @default(uuid()) @db.Uuid

  returnRequestId String @db.Uuid

  fileUploadId String @db.Uuid

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  fileUpload FileUpload @relation(fields: [fileUploadId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([returnRequestId, fileUploadId])
  @@index([fileUploadId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  channel NotificationChannel

  status NotificationStatus @default(PENDING)

  recipient String

  templateKey String?

  subject String?

  body String

  metadata Json?

  sentAt   DateTime?
  failedAt DateTime?

  error String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([channel])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String? @db.Uuid

  action String

  entityType String

  entityId String?

  before Json?

  after Json?

  metadata Json?

  ipAddress String?

  userAgent String?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}
