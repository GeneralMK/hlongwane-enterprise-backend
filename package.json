{
  "name": "hlongwane-enterprise-backend",
  "version": "1.0.0",
  "description": "Backend API for the Hlongwane Enterprise device commerce platform",
  "private": true,
  "main": "index.ts",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon -e ts,graphql,prisma --exec \"tsx -r dotenv/config index.ts\"",
    "start": "prisma migrate deploy && prisma generate && tsx -r dotenv/config index.ts",
    "studio": "prisma studio",
    "seed": "tsx -r dotenv/config prisma/seed.ts",
    "develop": "set -o allexport; source .env; set +o allexport && yarn db-sync && yarn seed && concurrently -k \"yarn dev\" \"yarn studio\"",
    "migrate": "prisma migrate dev --name",
    "migrate:deploy": "prisma migrate deploy",
    "db-sync": "prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prettier": "prettier \"src/**/*.ts\" --write",
    "prettier:check": "prettier \"src/**/*.ts\" --check",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --runInBand",
    "validate": "yarn prisma:validate && yarn typecheck && yarn lint && yarn test:ci",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@as-integrations/koa": "^1.1.1",
    "@graphql-tools/schema": "^10.0.2",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@prisma/client": "^6.16.3",
    "@supabase/supabase-js": "^2.116.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.6.7",
    "date-fns": "^2.30.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "graphql": "^16.8.1",
    "graphql-scalars": "^1.25.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.15.0",
    "koa": "^3.0.1",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-xml-body": "^3.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "paystack-sdk": "^3.6.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "uuid": "^11.0.4",
    "ws": "^8.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/jest": "^29.5.14",
    "@types/koa": "^3.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-xml-body": "^2.2.3",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^15.0.0",
    "@types/node": "^20.11.19",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.5",
    "prisma": "^6.16.3",
    "semantic-release": "^23.0.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.11"
  },
  "author": {
    "name": "masixole kondile",
    "email": "mkondile@analytikus.co.za"
  },
  "release": {
    "branches": [
      "develop"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
