{
  "name": "hlongwane-enterprise-backend",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL backend for the Hlongwane Enterprise device commerce ecosystem",
  "main": "dist/server.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@as-integrations/koa": "^1.1.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^16.6.1",
    "graphql": "^16.11.0",
    "koa": "^2.16.2",
    "koa-body": "^6.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^24.3.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
