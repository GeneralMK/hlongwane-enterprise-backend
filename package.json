{
  "name": "hlongwane-enterprise-backend",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
"scripts": {
  "dev": "nodemon -e ts,graphql,prisma --exec \"tsx -r dotenv/config index.ts\"",
  "studio": "prisma studio",
  "seed": "tsx -r dotenv/config prisma/seed.ts",
  "develop": "set -o allexport; source .env; set +o allexport && yarn db-sync && yarn seed && concurrently -k \"yarn dev\" \"yarn studio\"",
  "prettier": "prettier \"src/api/**/**/*.+(ts)\" --write",
  "start": "prisma migrate deploy && yarn seed && prisma generate && tsx -r dotenv/config index.ts",
  "migrate": "prisma migrate dev --name",
  "db-sync": "prisma db push",
  "prepare": "husky",
  "test": "jest",
  "test:watch": "jest --watch",
  "test:coverage": "jest --coverage",
  "lint": "eslint . --ext .ts",
  "lint:fix": "eslint . --ext .ts --fix"
},
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@as-integrations/koa": "^1.1.1",
    "@aws-sdk/client-s3": "^3.735.0",
    "@aws-sdk/client-ses": "^3.515.0",
    "@aws-sdk/client-sns": "^3.516.0",
    "@aws-sdk/s3-presigned-post": "^3.723.0",
    "@aws-sdk/s3-request-presigner": "^3.735.0",
    "@graphql-tools/schema": "^10.0.2",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@prisma/client": "^6.16.3",
    "@supabase/supabase-js": "^2.116.0",
    "apollo-server-koa": "^3.13.0",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^2.30.0",
    "dotenv": "^17.4.2",
    "generate-password": "^1.7.1",
    "google-auth-library": "^10.9.0",
    "graphql": "^16.8.1",
    "graphql-scalars": "^1.25.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.15.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "koa": "^3.0.1",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-xml-body": "^3.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "paystack-sdk": "^3.6.1",
    "pdfkit": "^0.17.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "uuid": "^11.0.4",
    "wrap-ansi": "^6.0.0",
    "ws": "^8.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/koa": "^3.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-xml-body": "^2.2.3",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^15.0.0",
    "@types/node": "^20.11.19",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.5",
    "prisma": "^6.16.3",
    "semantic-release": "^23.0.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.11"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "node"
  },
  "author": {
    "name": "masixole kondile",
    "email": "mkondile@analytikus.co.za"
  },
  "release": {
    "branches": [
      "develop"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
